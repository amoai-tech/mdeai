      "mcp__*__buy_pro",
      "mcp__*__unpause_project",
      "mcp__*__update_project_protection_bypass",
      "mcp__*__create_or_transfer_domain",
      "mcp__*__replace_domains_by_domain_records",
      "mcp__*__update_record",
      "mcp__*__get_project_token",
      "mcp__*__get_access_to_vercel_url",
      "mcp__*__upload_file",
      "mcp__*__create_edge_function_secret",
      "mcp__*__update_storage_config",
      "mcp__*__create_api_keys",
      "mcp__*__exchange_sso_token",
      "mcp__*__invalidate_by_src_images",
      "mcp__*__invalidate_by_tags",
      "mcp__*__record_events",
      "mcp__*__upload_artifact",
      "mcp__*__create_check",
      "mcp__*__create_deployment_check_run",
      "mcp__*__rerequest_check",
      "mcp__*__update_check",
      "mcp__*__update_deployment_check_run",
      "mcp__*__update_project_check",
      "mcp__*__create_drain",
      "mcp__*__test_drain",
      "mcp__*__update_drain",
      "mcp__*__create_flag",
      "mcp__*__create_sdk_key",
      "mcp__*__update_flag",
      "mcp__*__update_flag_segment",
      "mcp__*__update_flag_settings",
      "mcp__*__create_edge_config_token",
      "mcp__*__patch_edge_config_items",
      "mcp__*__patch_edge_config_schema",
      "mcp__*__restore_edge_config_backup",
      "mcp__*__update_edge_config",
      "mcp__*__activate_kms_signing_key",
      "mcp__*__create_kms_issuer_policy",
      "mcp__*__create_kms_signing_key",
