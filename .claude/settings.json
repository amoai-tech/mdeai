{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "mdeai-plain",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/guard-sensitive-paths.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/scan-secrets.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/no-service-role-in-src.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/gemini-model-pin.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/copilotkit-version-pin.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/places-api-field-mask.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/advanced-marker-needs-mapid.mjs" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/dist-leak-scan.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-ts.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-edited-ts.mjs" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/stop-rls-gate.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/stop-plain-language-gate.mjs" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git branch -D*)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset --linked)",
      "Bash(vercel --prod*)",
      "Edit(/home/sk/mde/**)",
      "Write(/home/sk/mde/**)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npm update*)",
      "Bash(gh repo create*)",
      "Bash(vercel deploy*)",
      "Bash(vercel link*)",
      "mcp__plugin_supabase_supabase__apply_migration",
      "mcp__plugin_supabase_supabase__deploy_edge_function",
      "mcp__plugin_supabase_supabase__execute_sql",
      "mcp__plugin_supabase_supabase__delete_branch",
      "mcp__plugin_supabase_supabase__merge_branch",
      "mcp__plugin_supabase_supabase__reset_branch",
      "mcp__plugin_supabase_supabase__rebase_branch",
      "mcp__plugin_supabase_supabase__create_branch",
      "mcp__plugin_supabase_supabase__create_project",
      "mcp__plugin_supabase_supabase__pause_project",
      "mcp__plugin_supabase_supabase__restore_project",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__apply_migration",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__execute_sql",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__deploy_edge_function",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__delete_branch",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__merge_branch",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__reset_branch",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__rebase_branch",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__create_branch",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__create_project",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__pause_project",
      "mcp__ed3787fc-985d-4fc2-87ac-e09815d3583a__restore_project",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__delete_project",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__pause_project",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__create_project",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__create_git_project",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__create_deployment",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__cancel_deployment",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__request_promote",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__request_rollback",
