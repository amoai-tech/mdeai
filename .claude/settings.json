      "mcp__*__update_kms_issuer_policy",
      "mcp__*__create_connector",
      "mcp__*__update_network",
      "mcp__*__update_rolling_release_config",
      "mcp__*__add_route",
      "mcp__*__edit_route",
      "mcp__*__generate_route",
      "mcp__*__patch_url_protection_bypass",
      "mcp__*__stage_redirects",
      "mcp__*__stage_routes",
      "mcp__*__update_route_versions",
      "mcp__*__update_version",
      "mcp__*__create_storage_stores_blob",
      "mcp__*__join_team",
      "mcp__*__create_sandboxes_sessions_by_session_id_snapshot_v2",
      "mcp__*__create_sandboxes_sessions_by_session_id_snapshot_v3",
      "mcp__*__create_sandboxes_v2",
      "mcp__*__create_sandboxes_v3",
      "mcp__*__create_sandboxes_v4",
      "mcp__*__create_session_directory",
      "mcp__*__extend_session_timeout",
      "mcp__*__kill_session_command"
    ],
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr create *)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx playwright test *)",
      "Bash(npm run dev:*)",
      "Bash(npm run build)",
      "Bash(npm run audit)",
      "Bash(npm run start)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run floor)",
      "Bash(npm run typecheck)",
      "Bash(npm run smoke:golden-queries)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat package.json)",
      "Bash(cat tsconfig.json)",
      "Bash(node .claude/hooks/*)",
      "mcp__copilotkit__search-docs",
      "mcp__copilotkit__search-code",
      "mcp__copilotkit__explore-docs",
      "mcp__copilotkit__explore-code",
      "mcp__copilotkit__search-ag-ui-docs",
      "mcp__copilotkit__search-ag-ui-code",
      "mcp__copilotkit__submit-feedback",
      "mcp__mastra__searchMastraDocs",
      "mcp__mastra__readMastraDocs",
      "mcp__mastra__mastraDocs",
      "mcp__mastra__getMastraHelp",
      "mcp__mastra__listMastraPackages",
      "mcp__mastra__getMastraExports",
      "mcp__mastra__getMastraExportDetails",
      "mcp__mastra__mastraMigration",
      "mcp__playwright-test__*",
      "mcp__chrome-devtools__*",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Mermaid_Chart__validate_and_render_mermaid_diagram",
      "mcp__plugin_linear_linear__list_issues",
