{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "mdeai-plain",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/guard-sensitive-paths.mjs"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/scan-secrets.mjs"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/no-service-role-in-src.mjs"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/gemini-model-pin.mjs"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/copilotkit-version-pin.mjs"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/places-api-field-mask.mjs"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/advanced-marker-needs-mapid.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/dist-leak-scan.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-ts.mjs"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-edited-ts.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/stop-rls-gate.mjs"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/stop-plain-language-gate.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git branch -D*)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset --linked)",
      "Bash(vercel --prod*)",
      "Edit(/home/sk/mde/**)",
      "Write(/home/sk/mde/**)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npm update*)",
      "Bash(git push *)",
      "Bash(gh repo create*)",
      "Bash(vercel deploy*)",
      "Bash(vercel link*)",
      "mcp__*__apply_migration",
      "mcp__*__deploy_edge_function",
      "mcp__*__execute_sql",
      "mcp__*__delete_branch",
      "mcp__*__merge_branch",
      "mcp__*__reset_branch",
      "mcp__*__rebase_branch",
      "mcp__*__create_branch",
      "mcp__*__create_project",
      "mcp__*__pause_project",
      "mcp__*__restore_project",
      "mcp__*__delete_project",
      "mcp__*__create_git_project",
      "mcp__*__create_deployment",
      "mcp__*__cancel_deployment",
      "mcp__*__request_promote",
      "mcp__*__request_rollback",
