      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__buy_domains",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__buy_single_domain",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__buy_credits",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__buy_credits_endpoint",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__buy_addon",
      "mcp__0e89c3dc-9b62-426a-8187-72fdcb689187__buy_pro"
    ],
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx playwright test *)",
      "Bash(npm run dev:*)",
      "Bash(npm run build)",
      "Bash(npm run audit)",
      "Bash(npm run start)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run floor)",
      "Bash(npm run typecheck)",
      "Bash(npm run smoke:golden-queries)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat package.json)",
      "Bash(cat tsconfig.json)",
      "Bash(node .claude/hooks/*)",
      "mcp__copilotkit__search-docs",
      "mcp__copilotkit__search-code",
      "mcp__copilotkit__explore-docs",
      "mcp__copilotkit__explore-code",
