{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "mdeai-plain",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/guard-sensitive-paths.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/scan-secrets.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/no-service-role-in-src.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/gemini-model-pin.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/copilotkit-version-pin.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/places-api-field-mask.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/advanced-marker-needs-mapid.mjs" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/dist-leak-scan.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-ts.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-edited-ts.mjs" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/stop-rls-gate.mjs" },
          { "type": "command", "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/stop-plain-language-gate.mjs" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git branch -D*)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset --linked)",
      "Bash(vercel --prod*)",
      "Edit(/home/sk/mde/**)",
      "Write(/home/sk/mde/**)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npm update*)",
      "Bash(git push *)",
      "Bash(gh repo create*)",
      "Bash(vercel deploy*)",
      "Bash(vercel link*)",
      "mcp__*__apply_*",
      "mcp__*__deploy_*",
      "mcp__*__execute_*",
      "mcp__*__create_*",
      "mcp__*__delete_*",
      "mcp__*__remove_*",
      "mcp__*__update_*",
      "mcp__*__edit_*",
      "mcp__*__add_*",
      "mcp__*__put_*",
      "mcp__*__upload_*",
      "mcp__*__issue_*",
      "mcp__*__merge_*",
      "mcp__*__reset_*",
      "mcp__*__rebase_*",
      "mcp__*__pause_*",
      "mcp__*__unpause_*",
      "mcp__*__restore_*",
      "mcp__*__cancel_*",
      "mcp__*__accept_*",
      "mcp__*__assign_*",
      "mcp__*__replace_*",
      "mcp__*__start_*",
      "mcp__*__complete_*",
      "mcp__*__approve_*",
      "mcp__*__request_promote",
      "mcp__*__request_rollback",
      "mcp__*__promote_*",
      "mcp__*__rollback_*",
      "mcp__*__buy_*",
      "mcp__*__enable_*",
      "mcp__*__disable_*",
      "mcp__*__get_project_token",
      "mcp__*__get_access_to_vercel_url"
    ],
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr create *)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx playwright test *)",
      "Bash(npm run dev:*)",
      "Bash(npm run build)",
      "Bash(npm run audit)",
      "Bash(npm run start)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run floor)",
      "Bash(npm run typecheck)",
      "Bash(npm run smoke:golden-queries)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat package.json)",
      "Bash(cat tsconfig.json)",
      "Bash(node .claude/hooks/*)",
      "mcp__copilotkit__search-docs",
      "mcp__copilotkit__search-code",
      "mcp__copilotkit__explore-docs",
      "mcp__copilotkit__explore-code",
      "mcp__copilotkit__search-ag-ui-docs",
      "mcp__copilotkit__search-ag-ui-code",
      "mcp__copilotkit__submit-feedback",
      "mcp__mastra__searchMastraDocs",
      "mcp__mastra__readMastraDocs",
      "mcp__mastra__mastraDocs",
      "mcp__mastra__getMastraHelp",
      "mcp__mastra__listMastraPackages",
      "mcp__mastra__getMastraExports",
      "mcp__mastra__getMastraExportDetails",
      "mcp__mastra__mastraMigration",
      "mcp__playwright-test__*",
      "mcp__chrome-devtools__*",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Mermaid_Chart__validate_and_render_mermaid_diagram",
      "mcp__plugin_linear_linear__list_issues",
      "mcp__plugin_linear_linear__get_issue",
      "mcp__plugin_linear_linear__list_projects",
      "mcp__plugin_linear_linear__get_project",
      "mcp__plugin_linear_linear__list_milestones",
      "mcp__plugin_linear_linear__list_issue_labels",
      "mcp__plugin_linear_linear__list_comments"
    ]
  },
  "env": {
    "LOG_LEVEL": "info"
  }
}
