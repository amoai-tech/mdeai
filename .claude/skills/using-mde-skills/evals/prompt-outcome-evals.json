        "one observable outcome",
        "independently gradeable rubric",
        "duplicate delivery evidence",
        "constraints",
        "STOP conditions",
        "independent verifier"
      ],
      "avoid": [
        "works properly",
        "production ready as an unexpanded criterion",
        "self-certification"
      ]
    },
    {
      "id": "goal-vs-outcome",
      "kind": "goal-boundary",
      "prompt": "Use /goal to finish SAN-1272.",
      "expect": [
        "Linear outcome remains authoritative",
