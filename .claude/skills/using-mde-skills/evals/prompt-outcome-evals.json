        "direct minimal instruction"
      ],
      "avoid": [
        "full S2-S4 task template",
        "subagents",
        "outcome rubric",
        "deep orchestration"
      ]
    },
    {
      "id": "outcome-positive-s4",
      "kind": "outcome-quality",
      "prompt": "Make Stripe webhook processing production ready.",
