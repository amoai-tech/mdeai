      "expect": [
        "observable outcome",
        "verified context",
        "dependencies",
        "constraints",
        "success criteria",
        "verification",
        "evidence output",
        "STOP conditions",
        "handoff"
      ],
      "avoid": [
        "vague expert persona",
        "unbounded exhaustive research",
        "mandatory subagents without dependency analysis"
      ]
    },
    {
      "id": "prompt-negative-s0",
      "kind": "prompt-quality",
      "prompt": "Fix the typo in this heading.",
